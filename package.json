{
  "name": "chatgpt-mcp-bridge",
  "version": "0.1.5",
  "description": "Cross-platform tray manager for ChatGPT Secure MCP Tunnel: Local Files + Chrome DevTools MCP.",
  "main": "src/main.js",
  "author": {
    "name": "Advertpreneur",
    "email": "haseeb.dlp@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/haseebgb92/ChatGPT-MCp.git"
  },
  "bugs": {
    "url": "https://github.com/haseebgb92/ChatGPT-MCp/issues"
  },
  "homepage": "https://github.com/haseebgb92/ChatGPT-MCp#readme",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/renderer.js && node --check bundled/local-mcp/server.js && node --check bundled/local-mcp/config.js && node --check bundled/local-mcp/security.js",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux:deb": "electron-builder --linux deb --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "chrome-devtools-mcp": "1.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.advertpreneur.chatgptmcpbridge",
    "productName": "ChatGPT MCP Bridge",
    "asar": false,
    "files": [
      "src/**/*",
      "bundled/**/*",
      "!bundled/meta-manager-proxy/**/*",
      "!bundled/*meta-manager*",
      "!**/*meta-manager-proxy*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/tunnel-client",
        "to": "tunnel-client",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "executableName": "chatgpt-mcp-bridge",
      "maintainer": "Advertpreneur <haseeb.dlp@gmail.com>",
      "synopsis": "Tray bridge for ChatGPT Secure MCP Tunnel",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "ChatGPT MCP Bridge",
          "Comment": "Manage Local Files and Web MCP tunnels for ChatGPT",
          "Icon": "chatgpt-mcp-bridge",
          "StartupWMClass": "chatgpt-mcp-bridge",
          "Terminal": "false",
          "Type": "Application",
          "Categories": "Utility;Development;"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "ChatGPT-MCP-Bridge-${version}-${os}-${arch}.${ext}"
  },
  "desktopName": "chatgpt-mcp-bridge.desktop"
}
