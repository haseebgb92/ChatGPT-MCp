{
  "name": "chatgpt-mcp-bridge",
  "version": "0.2.11",
  "description": "Cross-platform secure MCP tunnel manager for Local Files, Chrome and Meta Manager.",
  "main": "src/main.js",
  "author": {
    "name": "Advertpreneur",
    "email": "haseeb.dlp@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/haseebgb92/ChatGPT-MCp.git"
  },
  "bugs": {
    "url": "https://github.com/haseebgb92/ChatGPT-MCp/issues"
  },
  "homepage": "https://github.com/haseebgb92/ChatGPT-MCp#readme",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/updater.js && node --check src/renderer/renderer.js && node --check bundled/local-mcp/server.js && node --check bundled/local-mcp/config.js && node --check bundled/local-mcp/security.js && node --check bundled/meta-manager-proxy/server.js && node --check src/diagnostics.js && node --test tests/diagnostics.test.js",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux:deb": "electron-builder --linux deb --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "chrome-devtools-mcp": "1.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "electron": "41.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.advertpreneur.chatgptmcpbridge",
    "productName": "MCP Bridge",
    "asar": false,
    "files": [
      "src/**/*",
      "bundled/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/tunnel-client",
        "to": "tunnel-client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/node-runtime",
        "to": "node-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "executableName": "mcp-bridge",
      "maintainer": "Advertpreneur <haseeb.dlp@gmail.com>",
      "synopsis": "Tray bridge for ChatGPT Secure MCP Tunnel",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "MCP Bridge",
          "Comment": "Secure Local Files and Web MCP bridge",
          "Icon": "mcp-bridge",
          "StartupWMClass": "mcp-bridge",
          "Terminal": "false",
          "Type": "Application",
          "Categories": "Utility;Development;"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "MCP-Bridge-${version}-${os}-${arch}.${ext}",
    "electronFuses": {
      "runAsNode": true
    }
  },
  "desktopName": "mcp-bridge.desktop"
}
